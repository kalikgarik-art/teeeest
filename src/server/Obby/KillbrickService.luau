--!strict
-- Killbrick detection.
--
-- Every red killbrick generated by LevelGenerator kills the character
-- that touches it. The character then respawns automatically through
-- Player.RespawnLocation, which CheckpointService keeps pointing at
-- the player's current checkpoint.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage:WaitForChild("ObbyShared"):WaitForChild("Types"))
type LevelData = Types.LevelData

local KillbrickService = {}

local function onKillbrickTouched(hit: BasePart): ()
	local character = hit:FindFirstAncestorOfClass("Model")
	if character == nil then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= nil and humanoid.Health > 0 then
		humanoid.Health = 0
	end
end

function KillbrickService.Init(data: LevelData): ()
	for _, killbrick in data.Killbricks do
		killbrick.Touched:Connect(onKillbrickTouched)
	end
end

return KillbrickService
